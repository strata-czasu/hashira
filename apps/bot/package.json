{
  "name": "@hashira/bot",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "debug": "NODE_ENV=development bun run --inspect src/index.ts",
    "start": "bun run src/index.ts",
    "reload-commands": "bun run reload-commands.ts",
    "seed": "bun run seed.ts",
    "typecheck": "tsgo"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@discordjs/builders": "^1.12.2",
    "@hashira/core": "workspace:*",
    "@hashira/db": "workspace:*",
    "@hashira/env": "workspace:*",
    "@hashira/jsx": "workspace:*",
    "@hashira/paginate": "workspace:*",
    "@hashira/yotei": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/instrumentation": "^7.8.0",
    "@sentry/bun": "^9.46.0",
    "cheerio": "^1.1.2",
    "date-fns": "4.1.0",
    "openai": "6.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.8.0"
  }
}
