// TODO)) Should be per-guild
model ProfileSettings {
  userId          String        @id @unique
  titleId         Int?
  tintColorType   TintColorType @default(default)
  customTintColor Int? // For TintColorType.custom
  tintColorId     Int? // For TintColorType.fromItem
  // TODO)) Background image

  user      User       @relation(fields: [userId], references: [id])
  title     Item?      @relation(fields: [titleId], references: [id])
  tintColor TintColor? @relation(fields: [tintColorId], references: [id])
}

enum TintColorType {
  default
  fromItem
  dynamic
  custom
}

// TODO)) Drop after migrating to DisplayedProfileAchievement
model DisplayedProfileBadge {
  userId  String
  badgeId Int
  row     Int
  col     Int

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
  @@unique([userId, row, col])
}

model DisplayedProfileAchievement {
  userId        String
  achievementId Int
  row           Int

  user        User  @relation(fields: [userId], references: [id])
  achievement Badge @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
  @@unique([userId, row])
}
