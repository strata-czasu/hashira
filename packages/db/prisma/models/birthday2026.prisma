model Birthday2026Config {
  id                  Int      @id @default(autoincrement())
  guildId             String   @unique
  eventStartAt        DateTime @db.Timestamp(6)
  eventEndAt          DateTime @db.Timestamp(6)
  timezone            String
  visible             Boolean
  enabled             Boolean
  createdAt           DateTime @default(now()) @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @db.Timestamp(6)

  guild                Guild                             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  economy              Birthday2026EconomyConfig?
  textEarning          Birthday2026TextEarningConfig?
  voiceEarning         Birthday2026VoiceEarningConfig?
  teams                Birthday2026TeamConfig[]
  registrations        Birthday2026Registration[]
  rosterFinalization   Birthday2026RosterFinalization?
  settlement           Birthday2026Settlement?
  encounterConfig      Birthday2026EncounterConfig?
  encounters           Birthday2026Encounter[]
  powerupConfig        Birthday2026PowerupConfig?
  powerupActivations   Birthday2026PowerupActivation[]
  raidConfig           Birthday2026RaidConfig?
  raidAttempts         Birthday2026RaidAttempt[]
  milestones           Birthday2026Milestone[]
  feedBatches          Birthday2026FeedBatch[]
  personalTransactions Birthday2026PersonalTransaction[]
}

model Birthday2026EconomyConfig {
  configId               Int @id
  currencyId             Int @unique
  digestionDelaySeconds  Int

  config   Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
  currency Currency           @relation(fields: [currencyId], references: [id], onDelete: Restrict)
}

model Birthday2026TextEarningConfig {
  configId      Int @id
  windowSeconds Int
  dailyCap      Int

  config           Birthday2026Config                @relation(fields: [configId], references: [id], onDelete: Cascade)
  disabledChannels Birthday2026DisabledTextChannel[]
  dailyStates      Birthday2026DailyTextEarning[]
}

model Birthday2026VoiceEarningConfig {
  configId    Int @id
  unitSeconds Int
  dailyCap    Int

  config      Birthday2026Config             @relation(fields: [configId], references: [id], onDelete: Cascade)
  dailyStates Birthday2026DailyVoiceEarning[]
}

model Birthday2026TeamConfig {
  id       Int    @id @default(autoincrement())
  configId Int
  teamId   Int    @unique
  roleId   String @unique
  color    Int

  config       Birthday2026Config        @relation(fields: [configId], references: [id], onDelete: Cascade)
  team         Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  identity     Birthday2026TeamIdentity?
  persona      Birthday2026TeamPersona?
  artworks     Birthday2026TeamArtwork[]
  milestones   Birthday2026TeamMilestone[]
  statusMessage Birthday2026StatusMessage?
  tucznikChanges Birthday2026TucznikChange[]
  settlementResults Birthday2026SettlementTeam[]
  encounterEntries Birthday2026EncounterEntry[]
  encounterCompletions Birthday2026TeamEncounterCompletion[]
  powerupState Birthday2026TeamPowerupState?
  powerupActivations Birthday2026PowerupActivation[]
  raidAttemptsAsAttacker Birthday2026RaidAttempt[] @relation("birthday2026RaidAttackerTeam")
  raidAttemptsAsTarget Birthday2026RaidAttempt[] @relation("birthday2026RaidTargetTeam")
  memberStates Birthday2026MemberState[]
  wallet       Birthday2026TeamWallet?

  @@unique([id, configId])
  @@index([configId])
}

model Birthday2026TeamIdentity {
  teamConfigId  Int    @id
  configId      Int
  tucznikUserId String
  captainUserId String

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  tucznikUser User                   @relation("birthday2026Tucznik", fields: [tucznikUserId], references: [id], onDelete: Restrict)
  captainUser User                   @relation("birthday2026Captain", fields: [captainUserId], references: [id], onDelete: Restrict)

  @@unique([teamConfigId, configId])
  @@unique([configId, tucznikUserId])
  @@unique([configId, captainUserId])
}

model Birthday2026TeamPersona {
  teamConfigId      Int      @id
  configId          Int
  tucznikUserId     String
  title             String
  fallbackEmoji     String
  consentedAt       DateTime @db.Timestamp(6)
  configuredByUserId String
  updatedAt         DateTime @updatedAt @db.Timestamp(6)

  teamConfig  Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  tucznikUser User                   @relation("birthday2026PersonaSubject", fields: [tucznikUserId], references: [id], onDelete: Restrict)
  configuredBy User                  @relation("birthday2026PersonaConfiguredBy", fields: [configuredByUserId], references: [id], onDelete: Restrict)

  @@unique([teamConfigId, configId])
}

model Birthday2026Milestone {
  id        Int    @id @default(autoincrement())
  configId  Int
  position  Int
  threshold Int
  name      String

  config      Birthday2026Config          @relation(fields: [configId], references: [id], onDelete: Cascade)
  artworks    Birthday2026TeamArtwork[]
  completions Birthday2026TeamMilestone[]

  @@unique([id, configId])
  @@unique([configId, position])
  @@unique([configId, threshold])
}

model Birthday2026TeamArtwork {
  teamConfigId Int
  milestoneId  Int
  configId     Int
  imageUrl     String

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  milestone  Birthday2026Milestone  @relation(fields: [milestoneId, configId], references: [id, configId], onDelete: Cascade)

  @@id([teamConfigId, milestoneId])
  @@index([milestoneId, configId])
}

model Birthday2026TeamMilestone {
  teamConfigId Int
  milestoneId  Int
  configId     Int
  completedAt  DateTime @default(now()) @db.Timestamp(6)

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  milestone  Birthday2026Milestone  @relation(fields: [milestoneId, configId], references: [id, configId], onDelete: Cascade)

  @@id([teamConfigId, milestoneId])
  @@index([milestoneId, configId])
}

model Birthday2026StatusMessage {
  teamConfigId Int      @id
  configId     Int
  channelId    String
  messageId    String
  updatedAt    DateTime @updatedAt @db.Timestamp(6)

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)

  @@unique([teamConfigId, configId])
  @@unique([channelId, messageId])
}

model Birthday2026TucznikChange {
  id               Int      @id @default(autoincrement())
  teamConfigId     Int
  configId         Int
  previousUserId   String?
  nextUserId       String?
  changedByUserId  String
  changedAt        DateTime @default(now()) @db.Timestamp(6)

  teamConfig   Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  previousUser User?                  @relation("birthday2026PreviousTucznik", fields: [previousUserId], references: [id], onDelete: Restrict)
  nextUser     User?                  @relation("birthday2026NextTucznik", fields: [nextUserId], references: [id], onDelete: Restrict)
  changedBy    User                   @relation("birthday2026TucznikChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([teamConfigId, changedAt])
  @@index([previousUserId])
  @@index([nextUserId])
  @@index([changedByUserId])
}

model Birthday2026Settlement {
  configId                Int      @id
  cutoffAt                DateTime @db.Timestamp(6)
  settledAt               DateTime @db.Timestamp(6)
  settledByUserId         String
  digestedPendingPasza    Int
  discardedPersonalPasza  Int

  config            Birthday2026Config             @relation(fields: [configId], references: [id], onDelete: Cascade)
  settledBy         User                           @relation(fields: [settledByUserId], references: [id], onDelete: Restrict)
  teamResults       Birthday2026SettlementTeam[]
  individualResults Birthday2026IndividualResult[]

  @@index([settledByUserId])
}

model Birthday2026SettlementTeam {
  configId         Int
  teamConfigId     Int
  rank             Int
  permanentWeight  Int
  contributedPasza Int
  contributorCount Int

  settlement Birthday2026Settlement @relation(fields: [configId], references: [configId], onDelete: Cascade)
  teamConfig Birthday2026TeamConfig  @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)

  @@id([configId, teamConfigId])
  @@unique([configId, rank])
  @@index([teamConfigId, configId])
}

model Birthday2026IndividualResult {
  configId Int
  category Birthday2026IndividualResultCategory
  userId   String
  amount   Int

  settlement Birthday2026Settlement @relation(fields: [configId], references: [configId], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([configId, category, userId])
  @@index([userId])
}

model Birthday2026EncounterConfig {
  configId             Int    @id
  channelId            String
  responseWindowSeconds Int
  spawnIntervalSeconds Int
  individualReward     Int
  winCap               Int
  teamThreshold        Int
  teamReward           Int

  config Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Birthday2026Encounter {
  id          Int                       @id @default(autoincrement())
  configId    Int
  kind        Birthday2026EncounterKind
  sourceKey   String
  startsAt    DateTime                  @db.Timestamp(6)
  expiresAt   DateTime                  @db.Timestamp(6)
  resolvedAt  DateTime?                 @db.Timestamp(6)
  cancelledAt DateTime?                 @db.Timestamp(6)

  config          Birthday2026Config                    @relation(fields: [configId], references: [id], onDelete: Cascade)
  message         Birthday2026EncounterMessage?
  entries         Birthday2026EncounterEntry[]
  winner          Birthday2026EncounterWinner?
  teamCompletions Birthday2026TeamEncounterCompletion[]

  @@unique([configId, sourceKey])
  @@index([configId, kind, expiresAt])
}

model Birthday2026EncounterMessage {
  encounterId Int    @id
  channelId   String
  messageId   String

  encounter Birthday2026Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
}

model Birthday2026EncounterEntry {
  encounterId Int
  teamConfigId Int
  configId     Int
  userId       String
  enteredAt    DateTime @db.Timestamp(6)

  encounter Birthday2026Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([encounterId, userId])
  @@index([teamConfigId, configId])
  @@index([userId])
}

model Birthday2026EncounterWinner {
  encounterId  Int      @id
  configId     Int
  userId       String
  transactionId Int     @unique
  reward       Int
  wonAt        DateTime @db.Timestamp(6)

  encounter   Birthday2026Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction           @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([configId, userId])
}

model Birthday2026TeamEncounterCompletion {
  encounterId  Int
  teamConfigId Int
  configId     Int
  reward       Int
  completedAt  DateTime @db.Timestamp(6)

  encounter  Birthday2026Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)

  @@id([encounterId, teamConfigId])
  @@index([teamConfigId, configId])
}

model Birthday2026PowerupConfig {
  configId               Int @id
  maxInventory           Int
  effectDurationSeconds  Int
  turboDigestionSeconds  Int

  config Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Birthday2026TeamPowerupState {
  teamConfigId Int @id
  configId     Int
  inventory    Int

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)

  @@unique([teamConfigId, configId])
}

model Birthday2026PowerupActivation {
  id            Int      @id @default(autoincrement())
  teamConfigId  Int
  configId      Int
  captainUserId String
  activatedAt   DateTime @db.Timestamp(6)
  expiresAt     DateTime @db.Timestamp(6)

  config     Birthday2026Config     @relation(fields: [configId], references: [id], onDelete: Cascade)
  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  captain   User                   @relation(fields: [captainUserId], references: [id], onDelete: Restrict)

  @@index([teamConfigId, expiresAt])
  @@index([captainUserId])
}

model Birthday2026RaidConfig {
  configId         Int @id
  chargesPerTeam   Int
  maxSteal         Int
  protectedFloor  Int
  cooldownSeconds Int
  graceSeconds    Int
  perUserLossCap  Int
  repeatTargetCap Int

  config Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Birthday2026RaidAttempt {
  id                   Int                        @id @default(autoincrement())
  configId             Int
  attackerTeamConfigId Int
  targetTeamConfigId   Int
  captainUserId        String
  sourceKey            String
  outcome              Birthday2026RaidOutcome
  attemptedAt          DateTime                   @db.Timestamp(6)

  config       Birthday2026Config     @relation(fields: [configId], references: [id], onDelete: Cascade)
  attackerTeam Birthday2026TeamConfig @relation("birthday2026RaidAttackerTeam", fields: [attackerTeamConfigId, configId], references: [id, configId], onDelete: Cascade)
  targetTeam   Birthday2026TeamConfig @relation("birthday2026RaidTargetTeam", fields: [targetTeamConfigId, configId], references: [id, configId], onDelete: Cascade)
  captain      User                   @relation("birthday2026RaidCaptain", fields: [captainUserId], references: [id], onDelete: Restrict)
  transfer     Birthday2026RaidTransfer?

  @@unique([configId, sourceKey])
  @@index([attackerTeamConfigId, attemptedAt])
  @@index([targetTeamConfigId, attemptedAt])
  @@index([captainUserId])
}

model Birthday2026RaidTransfer {
  attemptId           Int @id
  sourceWalletId      Int
  destinationWalletId Int
  feedBatchId         Int
  victimUserId        String
  amount              Int

  attempt           Birthday2026RaidAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sourceWallet      Birthday2026TeamWallet  @relation("birthday2026RaidSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet Birthday2026TeamWallet  @relation("birthday2026RaidDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  feedBatch         Birthday2026FeedBatch   @relation(fields: [feedBatchId], references: [id], onDelete: Restrict)
  victim            User                    @relation("birthday2026RaidVictim", fields: [victimUserId], references: [id], onDelete: Restrict)

  @@index([victimUserId])
  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([feedBatchId])
}

model Birthday2026MemberState {
  id           Int      @id @default(autoincrement())
  configId     Int
  teamConfigId Int
  userId       String
  joinedAt     DateTime @default(now()) @db.Timestamp(6)

  teamConfig Birthday2026TeamConfig @relation(fields: [teamConfigId, configId], references: [id, configId], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([configId, userId])
  @@index([teamConfigId, configId])
  @@index([userId])
}

model Birthday2026Registration {
  configId     Int
  userId       String
  registeredAt DateTime @default(now()) @db.Timestamp(6)

  config Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([configId, userId])
  @@index([userId])
}

model Birthday2026RosterFinalization {
  configId        Int      @id
  analysisStartAt DateTime @db.Timestamp(6)
  analysisEndAt   DateTime @db.Timestamp(6)
  finalizedAt     DateTime @default(now()) @db.Timestamp(6)

  config Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model Birthday2026DisabledTextChannel {
  id        Int    @id @default(autoincrement())
  configId  Int
  channelId String

  config Birthday2026TextEarningConfig @relation(fields: [configId], references: [configId], onDelete: Cascade)

  @@unique([configId, channelId])
}

model Birthday2026DailyTextEarning {
  configId       Int
  userId         String
  eventDayIndex  Int
  awardedWindows Int

  config Birthday2026TextEarningConfig @relation(fields: [configId], references: [configId], onDelete: Cascade)
  user   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([configId, userId, eventDayIndex])
  @@index([userId])
}

model Birthday2026DailyVoiceEarning {
  configId      Int
  userId        String
  eventDayIndex Int
  awardedUnits  Int

  config Birthday2026VoiceEarningConfig @relation(fields: [configId], references: [configId], onDelete: Cascade)
  user   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([configId, userId, eventDayIndex])
  @@index([userId])
}

model Birthday2026TeamWallet {
  id              Int      @id @default(autoincrement())
  teamConfigId    Int      @unique
  currencyId      Int
  balance         Int
  permanentWeight Int
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  teamConfig   Birthday2026TeamConfig              @relation(fields: [teamConfigId], references: [id], onDelete: Cascade)
  currency     Currency                            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  transactions Birthday2026TeamWalletTransaction[]
  feedBatches  Birthday2026FeedBatch[]
  raidTransfersOut Birthday2026RaidTransfer[] @relation("birthday2026RaidSourceWallet")
  raidTransfersIn Birthday2026RaidTransfer[] @relation("birthday2026RaidDestinationWallet")

  @@index([currencyId])
}

model Birthday2026TeamWalletTransaction {
  id                    Int       @id @default(autoincrement())
  walletId              Int
  feedBatchId           Int
  personalTransactionId Int?      @unique
  source                Birthday2026TeamWalletTransactionSource
  entryType             EntryType
  amount                Int
  reason                String
  sourceKey             String
  createdAt             DateTime  @default(now()) @db.Timestamp(6)

  wallet              Birthday2026TeamWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  feedBatch           Birthday2026FeedBatch  @relation(fields: [feedBatchId], references: [id], onDelete: Restrict)
  personalTransaction Transaction?           @relation(fields: [personalTransactionId], references: [id], onDelete: Restrict)

  @@unique([walletId, source, sourceKey])
  @@index([feedBatchId])
}

model Birthday2026FeedBatch {
  id                    Int       @id @default(autoincrement())
  configId              Int
  walletId              Int
  userId                String
  personalTransactionId Int       @unique
  amount                Int
  remainingAmount       Int
  sourceKey             String
  digestAt              DateTime  @db.Timestamp(6)
  digestedAt            DateTime? @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @db.Timestamp(6)

  config              Birthday2026Config                  @relation(fields: [configId], references: [id], onDelete: Cascade)
  wallet              Birthday2026TeamWallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                User                                @relation("birthday2026FeedOwner", fields: [userId], references: [id], onDelete: Cascade)
  personalTransaction Transaction                         @relation(fields: [personalTransactionId], references: [id], onDelete: Restrict)
  teamTransactions    Birthday2026TeamWalletTransaction[]
  raidTransfers       Birthday2026RaidTransfer[]

  @@unique([configId, sourceKey])
  @@index([walletId, digestedAt, digestAt])
  @@index([userId])
}

enum Birthday2026PersonalTransactionSource {
  staffGrant
  feed
  textActivity
  voiceActivity
  settlement
  encounter
}

enum Birthday2026IndividualResultCategory {
  topContributor
}

enum Birthday2026EncounterKind {
  quickGrab
  teamThreshold
}

enum Birthday2026RaidOutcome {
  success
  noEligibleBatch
}

enum Birthday2026TeamWalletTransactionSource {
  feed
  digestion
  raid
}

model Birthday2026PersonalTransaction {
  id              Int                                   @id @default(autoincrement())
  configId        Int
  userId          String
  transactionId   Int                                   @unique
  source          Birthday2026PersonalTransactionSource
  sourceKey       String
  createdByUserId String?
  createdAt       DateTime                              @default(now()) @db.Timestamp(6)

  config        Birthday2026Config @relation(fields: [configId], references: [id], onDelete: Cascade)
  user          User               @relation("birthday2026PersonalTransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User?              @relation("birthday2026PersonalTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  transaction   Transaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([configId, source, sourceKey])
  @@index([userId])
  @@index([createdByUserId])
}
