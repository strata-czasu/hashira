exports[`preview html renderer renders containers, buttons and selects to markup 1`] = `"<div class="d-components"><div class="d-container d-accent" style="--d-accent:#5865f2"><div class="d-md"><h1>Team <strong>ranking</strong></h1></div><hr class="d-separator d-divided d-spacing-large"><div class="d-section"><div class="d-section-body"><div class="d-md"><p><strong>kasia</strong> — 120 pkt</p></div></div><div class="d-accessory"><img class="d-thumbnail" src="https://cdn.example.com/avatar.png" alt="avatar"></div></div><div class="d-row"><span class="d-btn d-btn-primary">Vote</span><span class="d-btn d-btn-secondary">Rules</span></div><div class="d-row"><span class="d-select"><span class="d-select-label">Red</span><svg class="d-chevron" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5.3 9.3a1 1 0 0 1 1.4 0l5.3 5.29 5.3-5.3a1 1 0 1 1 1.4 1.42l-6 6a1 1 0 0 1-1.4 0l-6-6a1 1 0 0 1 0-1.41z"/></svg></span></div></div><div class="d-gallery" style="grid-template-columns:repeat(1, minmax(0, 1fr))"><div class="d-gallery-item" style="height:200px"><img src="https://cdn.example.com/chart.png" alt=""></div></div><div class="d-md"><p>Plain trailing text with a mention: <span class="d-mention" data-kind="user" title="123">@user</span></p></div></div>"`;
